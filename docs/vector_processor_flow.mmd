%% How the single-cycle VM (RVSS) runs a program, and the functions a vector instruction goes
%% through in each stage. Same organisation as vector_assembler_flow.mmd:
%% - only RVSSProcessor::Step(): blocks IF, ID, EX, MEM, WB stacked top to bottom;
%% - inside each block the calls flow left to right, one box per function (file in italics);
%% - every arrow means "calls": caller on the left, callee on the right. Two arrows leaving one
%%   box are two calls (or two branches) made by that function. No decision diamonds.
%% Blocks are linked only block-to-block, so Mermaid keeps each block's left-to-right direction.
%% Mermaid centres subgraph titles; it has no option to put them in a corner.
flowchart TB

%% ========================= STEP: IF =========================
subgraph IFB["IF"]
  direction LR
  fetch["Fetch()<br/><i>rvss_processor.cpp</i>"]
  readInst["MemoryController::readInstruction()<br/><i>memory_controller.cpp</i>"]
  updPc["UpdateProgramCounter()<br/><i>processor_base.cpp</i>"]
  fetch --> readInst
  fetch --> updPc
end

%% ========================= STEP: ID =========================
subgraph IDB["ID"]
  direction LR
  decode["Decode()<br/><i>rvss_processor.cpp</i>"]
  ctrl["RVSSControlUnit::SetControlSignals()<br/><i>rvss_control_unit.cpp</i>"]
  decode --> ctrl
end

%% ========================= STEP: EX =========================
subgraph EXB["EX"]
  direction LR
  execute["Execute()<br/><i>rvss_processor.cpp</i>"]
  execVec["ExecuteVector()<br/><i>rvss_processor.cpp</i>"]
  exStage["VectorExecuteStage()<br/><i>vector_stages.cpp</i>"]
  plan["PlanVectorMemory()<br/><i>vector_memory.cpp</i>"]
  decMem["DecodeVectorMem()<br/><i>vector_memory.cpp</i>"]
  sync["VectorScratch::SyncFrom()<br/><i>vector_stages.cpp</i>"]
  compute["ExecuteVectorCompute()<br/><i>vector_execute.cpp</i>"]
  execute --> execVec --> exStage
  exStage --> plan --> decMem
  exStage --> sync --> compute
end

%% ========================= STEP: MEM =========================
subgraph MEMB["MEM"]
  direction LR
  writeMem["WriteMemory()<br/><i>rvss_processor.cpp</i>"]
  memStage["VectorMemoryStage()<br/><i>vector_stages.cpp</i>"]
  access["AccessVectorMemory()<br/><i>vector_memory.cpp</i>"]
  storeEl["StoreElement()<br/><i>vector_memory.cpp</i>"]
  loadEl["LoadElement()<br/><i>vector_memory.cpp</i>"]
  memWrite["MemoryController::write*()<br/><i>memory_controller.cpp</i>"]
  memRead["MemoryController::read*()<br/><i>memory_controller.cpp</i>"]
  writeMem --> memStage --> access
  access --> storeEl --> memWrite
  access --> loadEl --> memRead
end

%% ========================= STEP: WB =========================
subgraph WBB["WB"]
  direction LR
  writeBack["WriteBack()<br/><i>rvss_processor.cpp</i>"]
  wbVec["WriteBackVector()<br/><i>rvss_processor.cpp</i>"]
  wbStage["VectorWriteBackStage()<br/><i>vector_stages.cpp</i>"]
  wbMem["WriteBackVectorMemory()<br/><i>vector_memory.cpp</i>"]
  wrReg["RegisterFile::WriteVectorRegister()<br/><i>registers.cpp</i>"]
  wrCsrA["RegisterFile::WriteCsr()<br/><i>registers.cpp</i>"]
  wrGpr["RegisterFile::WriteGpr()<br/><i>registers.cpp</i>"]
  writeBack --> wbVec
  wbVec --> wbStage
  wbVec --> wrGpr
  wbStage --> wbMem
  wbStage --> wrReg
  wbStage --> wrCsrA
end

%% ========================= VERTICAL ORDER =========================
IFB --> IDB --> EXB --> MEMB --> WBB
